body {
  font-family: Arial, sans-serif;
  background: #fff;
  color: #111;
  margin: 0;
  padding: 0;
  transition: background-color 0.3s, color 0.3s;
}
.dark-mode {
  background: #121212;
  color: #eee;
}
header {
  background: #f4f4f4;
  padding: 1rem;
  text-align: center;
}
header input[type="text"] {
  padding: 10px;
  margin-top: 10px;
  width: 80%;
  border-radius: 5px;
}
button {
  margin-top: 10px;
  padding: 10px;
  cursor: pointer;
  border-radius: 5px;
}
.category {
  padding: 1rem;
  border-bottom: 1px solid #ccc;
}
.item {
  background: #f9f9f9;
  padding: 1rem;
  margin: 1rem 0;
  border-radius: 8px;
}
.dark-mode .item {
  background: #1e1e1e;
}
.arabic {
  font-size: 1.5rem;
  direction: rtl;
  text-align: right;
}
.phonetic {
  color: #666;
}

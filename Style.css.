body {
  font-family: 'Cairo', sans-serif;
  background: #ffffff;
  color: #222;
  margin: 0;
  padding: 0;
  transition: background-color 0.3s, color 0.3s;
}

.dark-mode {
  background: #121212;
  color: #f0f0f0;
}

.topbar {
  background: #009688;
  color: white;
  padding: 1rem;
  text-align: center;
}

.controls {
  margin-top: 1rem;
}

.controls input[type=\"text\"] {
  padding: 10px;
  width: 70%;
  border-radius: 5px;
  border: none;
}

button {
  padding: 10px;
  margin-left: 10px;
  background: #00796b;
  color: white;
  border: none;
  border-radius: 5px;
  cursor: pointer;
}

.categories {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  padding: 1rem;
  background: #f1f1f1;
}

.categories button {
  margin: 5px;
}

.category {
  padding: 1rem;
}

.item {
  background: #fafafa;
  margin: 1rem 0;
  padding: 1rem;
  border-radius: 10px;
  box-shadow: 0 2px 5px rgba(0,0,0,0.1);
}

.arabic {
  font-size: 1.5rem;
  direction: rtl;
  text-align: right;
}

.phonetic {
  font-style: italic;
  color: #555;
}

footer {
  text-align: center;
  padding: 1rem;
  background: #eee;
  font-size: 0.9rem;
}
